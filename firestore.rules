rules_version = '2';

/**
 * Firestore Security Rules
 *
 * REFERENCE ONLY - this file is gitignored and not used by any deploy step.
 * The live rules are published directly via the Firebase console
 * (Firestore Database > Rules). Keep this in sync by hand if you want a
 * local copy to read/diff against - it does nothing on its own.
 *
 * These only govern access from a browser using the Firebase *client* SDK
 * (lib/firebase.ts) - either an anonymous visitor (submitting a case) or a
 * signed-in staff member (the admin dashboard). Server-side code that uses
 * the Admin SDK with a service account (lib/firebaseAdmin.ts) - all admin
 * dashboard reads, and the cron cleanup job - ALWAYS bypasses these rules
 * entirely, by design. So these rules only need to cover what the client
 * SDK actually does; they are not a general-purpose data access layer.
 *
 * billing.paymentStatus is written ONLY by the Admin SDK (lib/payments.ts),
 * from server code that has already verified the claim against Stripe itself
 * - either a signature-verified webhook event (app/api/webhooks/stripe) or a
 * Checkout Session retrieved by ID (app/api/verify-payment). There used to be
 * an anonymous client-write branch here for this exact field (rules can check
 * the SHAPE of a write, not the truth of a claim - nothing here could prove a
 * claimed "paid" corresponded to a real charge); it's been removed now that
 * the webhook exists, so no rule below can touch billing.paymentStatus at all
 * once a doc is off "draft".
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- //
    // Helpers
    // ---------------------------------------------------------------- //

    // There's no custom-claim/role system in this app (see hooks/useAuth.ts) -
    // admin accounts are provisioned by hand in the Firebase console, and any
    // signed-in Firebase Auth user is trusted as admin. If a public sign-up
    // flow is ever added, this is the one place that needs updating to check
    // a real role/claim instead of just "is anyone signed in".
    function isAdmin() {
      return request.auth != null;
    }

    // True only if the set of fields that changed between the existing doc
    // (resource.data) and the incoming write (request.resource.data) is a
    // subset of `keys`. This is how "admin can only flip status/archive
    // fields, not rewrite owner/medical data" gets enforced without having
    // to duplicate a full field-by-field schema in these rules.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Cheap guard against an anonymous caller scripting a flood of
    // oversized docs to run up read/write/storage costs. A realistic worst
    // -case real doc (full owner + dog fields, ~10 S3 file-key refs, a pdf
    // ref) lands around 1.5-2KB - 8KB is several times that, generous
    // enough to never reject a real submission, tight enough to actually
    // limit abuse. Tune here if real-world docs turn out bigger than
    // expected.
    function underSizeLimit() {
      return request.resource.size() < 8000;
    }

    // ---------------------------------------------------------------- //
    // submissions - one doc per dog. Contains owner PII and medical data.
    // ---------------------------------------------------------------- //
    match /submissions/{submissionId} {

      // Single-doc reads are left open, even to anonymous callers - a
      // deliberate trade-off, not an oversight. saveDraftFiles() (lib/firebase.ts)
      // does a getDoc() on this exact doc ID before writing, purely to check
      // whether it already exists (so it only stamps createdAt once, on the
      // very first write). Rules can't scope a read to "only the doc you're
      // about to write" - the alternative would be moving that existence
      // check into a server API route instead. Doc IDs are UUID-based (see
      // the create rule below), so this only exposes one record to someone
      // who already has that exact ID (e.g. a leaked link) - not to anyone
      // browsing/enumerating the database.
      allow get: if true;

      // Listing/querying the whole collection, on the other hand, would hand
      // an anonymous caller every owner's name/email/medical data at once -
      // that's admin-only.
      allow list: if isAdmin();

      // Creating a new doc: either saveDraftFiles's first write for a dog,
      // or (less commonly) createSubmission running before any draft exists.
      // Doc ID must equal `{s3SubmissionId}_dog{dogIndex}`, exactly how
      // getSubmissionDraftId() builds it - stops writing under an
      // arbitrary/unrelated ID.
      allow create: if
        submissionId == request.resource.data.s3SubmissionId + '_dog' + string(request.resource.data.dogIndex) &&
        underSizeLimit() &&
        (
          // Draft creates (saveDraftFiles) only ever write this exact field
          // set - locking to hasOnly means owner/dog/billing/archived etc
          // can't be smuggled in on a draft doc at all, not even to fields
          // that never get checked by downstream admin views.
          (
            request.resource.data.status == 'draft' &&
            request.resource.data.keys().hasOnly(['s3SubmissionId', 'dogIndex', 'status', 'files', 'updatedAt', 'createdAt'])
          ) ||
          // pendingReview creates (createSubmission, when no prior draft
          // exists) - full shape required, and paymentStatus can only be
          // one of the two values the app itself ever sets at creation time
          // (never "paid"/"test" - those only ever get set later, after
          // Stripe actually confirms the charge).
          (
            request.resource.data.status == 'pendingReview' &&
            request.resource.data.keys().hasAll([
              'status', 's3SubmissionId', 'dogIndex', 'submitterType', 'payer',
              'createdAt', 'updatedAt', 'archived', 'archivedBy', 'billing',
              'owner', 'dog',
            ]) &&
            request.resource.data.archived == false &&
            request.resource.data.billing.paymentStatus in ['unpaid', 'pending']
          )
        );

      // Updates to an existing doc: three distinct, narrow shapes are
      // allowed, matching the code paths that actually update a submission
      // from the client SDK. Everything else is denied by default - notably,
      // that means billing.paymentStatus is not writable through this match
      // block at all; only the Admin SDK (lib/payments.ts) sets it, and that
      // bypasses these rules entirely.
      allow update: if underSizeLimit() && (
        // (a) Admin, via ChangeStatusButton / ArchiveButton - can only ever
        // touch these exact fields, even though they're authenticated. This
        // stops a bug (or a compromised admin session) from silently
        // rewriting owner/billing data through this same code path.
        (isAdmin() && onlyChanged(['status', 'archived', 'archivedAt', 'archivedBy', 'updatedAt'])) ||

        // (b) Anonymous checkout write (createSubmission merging onto an
        // existing draft) - only a draft -> pendingReview transition, same
        // required-fields + paymentStatus restriction as the create rule.
        (
          resource.data.status == 'draft' &&
          request.resource.data.status == 'pendingReview' &&
          request.resource.data.keys().hasAll([
            'status', 's3SubmissionId', 'dogIndex', 'submitterType', 'payer',
            'createdAt', 'updatedAt', 'archived', 'archivedBy', 'billing',
            'owner', 'dog',
          ]) &&
          request.resource.data.archived == false &&
          request.resource.data.billing.paymentStatus in ['unpaid', 'pending']
        ) ||

        // (c) Anonymous draft file-batch merge (saveDraftFiles called again
        // as a later upload batch lands, e.g. supporting docs after DICOM
        // files) - doc stays "draft", only files/updatedAt actually change.
        (
          resource.data.status == 'draft' &&
          request.resource.data.status == 'draft' &&
          onlyChanged(['files', 'updatedAt'])
        )

        // A fourth branch used to live here: an anonymous payment-status flip
        // after a Stripe redirect (the old client-side
        // updateSubmissionPaymentStatus). Removed now that billing.paymentStatus
        // is written server-side only, via the Admin SDK, after Stripe
        // verification (see the file header and lib/payments.ts).
      );

      // No client-side deletes anywhere in the app - the only deletes are
      // the Admin-SDK cron job cleaning up stale drafts, which bypasses
      // these rules entirely.
      allow delete: if false;
    }

    // ---------------------------------------------------------------- //
    // testSubmissions - frozen pre-launch data, read-only reference; plus
    // a admin-only "create test submission" button (see
    // CreateTestSubmissionButton) writes hardcoded sample docs here for
    // manual testing. No anonymous code path touches this collection.
    // ---------------------------------------------------------------- //
    match /testSubmissions/{submissionId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------- //
    // Deny everything else by default - replaces the Firebase-generated
    // "open to anyone until 2027-05-12" placeholder rule.
    // ---------------------------------------------------------------- //
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
